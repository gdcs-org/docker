## Stage 1: SDK Installation
FROM ubuntu:24.04 AS sdk-builder

# Minimal dependencies just to run the installer
RUN apt-get update && \
   apt-get install -y --no-install-recommends xz-utils \
   file \
   python3 && \
   apt-get clean && \
   rm -rf /var/lib/apt/lists/*

# Install SDK - this entire stage will be discarded
COPY ./sdk/rdk-glibc-aarch64-aarch64-toolchain-*.sh /tmp/sdk-installer.sh
RUN chmod +x /tmp/sdk-installer.sh && \
   /tmp/sdk-installer.sh -y -d /opt/sdk

## Stage 2: Final Image
FROM ubuntu:24.04

# Install dependencies and Rust in a single layer (NO upgrade to save ~800MB)
RUN apt-get update && \
   apt-get install -y --no-install-recommends \
   locales \
   git \
   curl \
   vim \
   wget \
   file \
   patch \
   openssh-client \
   ca-certificates && \
   locale-gen en_US.UTF-8 && \
   curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
   apt-get clean && \
   rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /root/.cargo/registry

ENV LANG=en_US.UTF-8
ENV LD_LIBRARY_PATH=""

# Copy SDK from builder stage (installer file never enters this stage!)
COPY --from=sdk-builder /opt/sdk /opt/sdk

# Copy Cargo config
RUN mkdir -p /root/.cargo
COPY --chmod=644 ./configs/builder/config.toml /root/.cargo/config.toml

# Create symlinks in /usr/bin for cross-compiler tools
RUN for tool in /opt/sdk/sysroots/aarch64-rdksdk-linux/usr/bin/aarch64-rdk-linux/aarch64-rdk-linux-*; do \
        basename=$(basename "$tool" | sed 's/^aarch64-rdk-linux-//'); \
        ln -s "$tool" "/usr/bin/$basename"; \
    done
    
    #&& 
    #ln -s /opt/sdk/sysroots/aarch64-rdksdk-linux/usr/bin/aarch64-rdk-linux/aarch64-rdk-linux-gcc /usr/bin/cc

COPY --chmod=600 ./configs/builder/ssh/* /root/.ssh/
COPY --chmod=600 ./configs/builder/ssh/* /home/stepherg/.ssh/
COPY --chmod=644 ./configs/builder/gitconfig /home/stepherg/.gitconfig
COPY --chmod=644 ./configs/builder/gitconfig /root/.gitconfig

# Set up environment
RUN echo "source /opt/sdk/environment-setup-*" >> /etc/bash.bashrc

WORKDIR /workspace
CMD ["/bin/bash"]
